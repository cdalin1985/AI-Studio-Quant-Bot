{
  "entities": {
    "Strategy": {
      "title": "Strategy",
      "description": "Trading strategy definitions and performance metrics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "sharpe": { "type": "number" },
        "winRate": { "type": "number" },
        "maxDrawdown": { "type": "number" },
        "trades": { "type": "number" }
      },
      "required": ["uid", "name", "enabled"]
    }
  },
  "firestore": {
    "/users/{userId}/strategies/{strategyId}": {
      "schema": "Strategy",
      "description": "User specific trading strategies"
    }
  }
}
